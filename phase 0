Phase 0: Infrastructure
1. Eureka Server (staynest-eureka-server)
Dependencies in STS: Eureka Server
application.yml:
yaml

server:
  port: 8761

eureka:
  client:
    register-with-eureka: false
    fetch-registry: false
  server:
    enable-self-preservation: false

EurekaServerApplication.java:
java

package com.staynest.eureka;

import org.springframework.boot.SpringApplication;
import org.springframework.boot.autoconfigure.SpringBootApplication;
import org.springframework.cloud.netflix.eureka.server.EnableEurekaServer;

@SpringBootApplication
@EnableEurekaServer
public class EurekaServerApplication {
    public static void main(String[] args) {
        SpringApplication.run(EurekaServerApplication.class, args);
    }
}

2. API Gateway (staynest-api-gateway)
Dependencies in STS: Gateway, Eureka Discovery Client
application.yml:
yaml

server:
  port: 8080

spring:
  application:
    name: api-gateway
  cloud:
    gateway:
      routes:
        - id: iam-service
          uri: lb://iam-service
          predicates:
            - Path=/api/auth/**, /api/users/**, /api/audit-logs/**
        
        - id: room-service
          uri: lb://room-service
          predicates:
            - Path=/api/room-types/**, /api/rooms/**, /api/rate-plans/**, /api/hospitality-reports/**
        
        - id: reservation-service
          uri: lb://reservation-service
          predicates:
            - Path=/api/guests/**, /api/reservations/**
        
        - id: frontdesk-service
          uri: lb://frontdesk-service
          predicates:
            - Path=/api/stay-records/**, /api/folio-items/**
        
        - id: housekeeping-service
          uri: lb://housekeeping-service
          predicates:
            - Path=/api/housekeeping-tasks/**, /api/maintenance-requests/**
        
        - id: fb-service
          uri: lb://fb-service
          predicates:
            - Path=/api/menu-items/**, /api/fb-orders/**, /api/dining-reservations/**
        
        - id: revenue-service
          uri: lb://revenue-service
          predicates:
            - Path=/api/reports/**
        
        - id: notification-service
          uri: lb://notification-service
          predicates:
            - Path=/api/notifications/**

      default-filters:
        - DedupeResponseHeader=Access-Control-Allow-Credentials Access-Control-Allow-Origin

eureka:
  client:
    service-url:
      defaultZone: http://localhost:8761/eureka/

