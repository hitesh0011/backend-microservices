package com.staynest.room.service;

import com.staynest.room.dto.RoomRequest;
import com.staynest.room.entity.Room;
import com.staynest.room.entity.RoomType;
import com.staynest.room.enums.RoomStatus;
import com.staynest.room.enums.RoomTypeName;
import com.staynest.room.exception.BadRequestException;
import com.staynest.room.repository.RoomRepository;
import com.staynest.room.repository.RoomTypeRepository;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;

import java.math.BigDecimal;
import java.util.Optional;

import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.*;

@ExtendWith(MockitoExtension.class)
class RoomServiceTest {

    @Mock private RoomRepository roomRepository;
    @Mock private RoomTypeRepository roomTypeRepository;
    @InjectMocks private RoomService roomService;

    private RoomType roomType;
    private Room room;
    private RoomRequest request;

    @BeforeEach
    void setUp() {
        roomType = RoomType.builder()
                .roomTypeId(1).name(RoomTypeName.STANDARD)
                .baseRate(new BigDecimal("2000")).maxOccupancy(2).build();

        room = Room.builder()
                .roomId(1).roomNumber("101").floor(1)
                .roomType(roomType).status(RoomStatus.AVAILABLE).build();

        request = new RoomRequest();
        request.setRoomNumber("101");
        request.setFloor(1);
        request.setRoomTypeId(1);
    }

    @Test
    void addRoom_validRoomType_shouldCreate() {
        when(roomTypeRepository.findById(1)).thenReturn(Optional.of(roomType));
        when(roomRepository.save(any(Room.class))).thenReturn(room);

        var response = roomService.addRoom(request);
        assertNotNull(response);
        assertEquals("101", response.getRoomNumber());
    }

    @Test
    void addRoom_invalidRoomType_shouldThrow() {
        when(roomTypeRepository.findById(99)).thenReturn(Optional.empty());
        assertThrows(BadRequestException.class, () -> roomService.addRoom(request));
    }

    @Test
    void updateRoomStatus_shouldChange() {
        when(roomRepository.findById(1)).thenReturn(Optional.of(room));
        when(roomRepository.save(any(Room.class))).thenReturn(room);

        var response = roomService.updateRoomStatus(1, RoomStatus.OCCUPIED);
        assertEquals(RoomStatus.OCCUPIED, response.getStatus());
    }

    @Test
    void getRoomsByStatus_shouldReturnCorrect() {
        when(roomRepository.findByStatus(RoomStatus.AVAILABLE)).thenReturn(java.util.List.of(room));
        var rooms = roomService.getRoomsByStatus(RoomStatus.AVAILABLE);
        assertEquals(1, rooms.size());
    }
